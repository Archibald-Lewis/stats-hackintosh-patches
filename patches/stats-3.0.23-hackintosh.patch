+// IOPCIPrimaryMatch may describe a vendor-wide match, such as
+// "0x000010de&0x0000ffff", rather than a complete device/vendor ID.
+private func matchesPCI(_ pci: String, expression: String) -> Bool {
+    func number(_ value: Substring) -> UInt32? {
+        let text = value.lowercased()
+        return UInt32(text.hasPrefix("0x") ? String(text.dropFirst(2)) : text, radix: 16)
+    }
+    guard let device = number(Substring(pci)) else { return false }
+    return expression.split(whereSeparator: { $0.isWhitespace }).contains { term in
+        let parts = term.split(separator: "&", omittingEmptySubsequences: false)
+        guard (1...2).contains(parts.count), let value = number(parts[0]) else { return false }
+        if parts.count == 1 { return device == value }
+        guard let mask = number(parts[1]) else { return false }
+        return device & mask == value & mask
+    }
+}
