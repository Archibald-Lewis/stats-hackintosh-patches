+// Local telemetry export for the user's USB monitoring panel.
+private func exportVK03(_ name: String, _ values: [String: Double]) {
+    guard UserDefaults.standard.bool(forKey: "VK03PanelExport"), values.values.allSatisfy({ $0.isFinite }) else { return }
+    let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("Stats/VK03Panel", isDirectory: true)
+    do {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        var payload = values
+        payload["timestamp"] = Date().timeIntervalSince1970
+        let bytes = try JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys])
+        try bytes.write(to: directory.appendingPathComponent(name + ".json"), options: .atomic)
+    } catch { /* A disconnected panel must never interrupt Stats. */ }
+}
+
+private var lastVK03SpecsExport = Date.distantPast
+private func exportVK03Specs() {
+    guard UserDefaults.standard.bool(forKey: "VK03PanelExport"), Date().timeIntervalSince(lastVK03SpecsExport) > 15 else { return }
+    let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("Stats/VK03Panel", isDirectory: true)
+    do {
+        var profile: [String: Any] = ["timestamp": Date().timeIntervalSince1970]
+        if let cpu = SystemKit.shared.device.info.cpu {
+            profile["cpu"] = try JSONSerialization.jsonObject(with: JSONEncoder().encode(cpu))
+        }
+        if let ram = SystemKit.shared.device.info.ram {
+            profile["ram"] = try JSONSerialization.jsonObject(with: JSONEncoder().encode(ram))
+        }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try JSONSerialization.data(withJSONObject: profile, options: [.sortedKeys])
+            .write(to: directory.appendingPathComponent("hardware.json"), options: .atomic)
+        lastVK03SpecsExport = Date()
+    } catch { }
+}
